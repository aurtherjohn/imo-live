<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background (Android 8+).

  The launcher masks this 108x108dp layer down to whatever shape the OEM uses
  (circle, squircle, rounded square, teardrop), so only the centre 72dp is
  guaranteed visible and only the centre 66dp is guaranteed safe. A background
  therefore must be a full-bleed fill, never a shape with corners — the corners
  get cropped and the icon looks off-centre on a circular launcher.

  Flat white (#FFFFFF), matching the opaque `applogo.jpg` plate the launcher
  icon is specified to use. The mark is a two-tone blue/green speech bubble:
  the blue ring and the green "Live" flag both hold up against white, and the
  "Live" lettering is white-on-green rather than white-on-white, so nothing in
  the artwork disappears into the plate.

  The previous dark #141417 tile existed because the old mark was a magenta
  gradient ring that vanished against a matching gradient background. That
  artwork is gone, so the dark tile went with it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0 h108 v108 h-108 z"
        android:fillColor="#FFFFFFFF" />
</vector>
