<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon, round variant (Android 8.0 / API 26+).

  Resolved by `android:roundIcon` on launchers that request a round icon. The
  adaptive layers are shape-agnostic — the launcher applies its own circular
  mask — so this file is identical to `ic_launcher.xml`. The API 24–25 fallback
  is `mipmap-*dpi/ic_launcher_round.png`, which is the artwork pre-masked to a
  disc because those releases have no adaptive-icon support at all.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
